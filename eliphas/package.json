{
  "name": "eliphas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/*.test.ts",
    "db:bundle": "node -e \"const fs=require('fs');const dir='supabase/migrations';const files=fs.readdirSync(dir).filter(f=>f.endsWith('.sql')).sort();fs.writeFileSync('supabase/hosted-setup.sql','-- GENERATED by npm run db:bundle. Do not edit: change supabase/migrations instead.\\n-- Paste this whole file into Supabase Dashboard -> SQL Editor -> Run, once, on a NEW project.\\n\\n'+files.map(f=>'-- ===== '+f+' =====\\n'+fs.readFileSync(dir+'/'+f,'utf8')).join('\\n'))\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
