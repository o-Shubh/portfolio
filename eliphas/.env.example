# Copy this file to .env.local and fill in the values.
# Local:  run `npx supabase status` and copy the API URL, publishable key and secret key.
# Hosted: Supabase dashboard -> Project Settings -> API Keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# "Publishable" key (or the legacy "anon" key). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (or the legacy "service_role" key). SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public URL of the site (used for links and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production domain printed in Edition ID QR codes (https://your-domain.in, no path). SERVER ONLY.
# Leave empty until the real domain is live: QR codes then show as previews and print downloads stay off.
PUBLIC_SITE_ORIGIN=

# Razorpay (Dashboard → Account & Settings → API Keys, in TEST mode for now).
# Leave empty to use the built-in pretend payment while developing (never on the live site).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL https://<your-site>/api/razorpay/webhook, events payment.captured, payment.failed,
# refund.processed and refund.failed
RAZORPAY_WEBHOOK_SECRET=

# Order update emails via Resend (resend.com). Verify your domain in Resend first. Without these, emails are
# recorded as "skipped" in Admin → Emails and nothing is sent.
RESEND_API_KEY=
EMAIL_FROM="Eliphas Indicus <orders@your-domain.in>"
# Optional: where customer replies go (e.g. your support inbox)
EMAIL_REPLY_TO=
# Protects the daily email retry job (Vercel sends it automatically when set). Any long random text.
CRON_SECRET=

# Play Store app (optional, after you create the Android app with PWABuilder)
# Package name and the SHA-256 fingerprint of the app signing key (Play Console → App integrity)
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT=
